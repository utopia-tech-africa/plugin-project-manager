  "info": {
    "title": "Plugin Project Manager API",
    "description": "API for Plugin teams to create projects, move work through configurable phases, and hand off documents.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@plugin.local"
          },
          "password": {
            "type": "string",
            "example": "plugin-admin-change-me"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SignOutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "AcceptInviteDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "example": "Ama Mensah"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "fullName",
          "password"
        ]
      },
      "CreateTeamDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Production"
          },
          "slug": {
            "type": "string",
            "example": "production"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateTeamDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateSubTeamDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Design"
          },
          "slug": {
            "type": "string",
            "example": "design"
          }
        },
        "required": [
          "name"
        ]
      },
      "PhaseItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Design"
          },
          "slug": {
            "type": "string",
            "example": "design",
            "description": "Generated from the phase name if omitted."
          },
          "step": {
            "type": "number",
            "example": 1,
            "description": "Phases that share a step run in parallel. The next step starts when every phase on this step is done."
          },
          "subTeamId": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "step",
          "subTeamId"
        ]
      },
      "ReplacePhasesDto": {
        "type": "object",
        "properties": {
          "phases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhaseItemDto"
            }
          }
        },
        "required": [
          "phases"
        ]
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ama@plugin.local"
          },
          "teamId": {
            "type": "string"
          },
          "subTeamId": {
            "type": "string"
          },
          "teamRole": {
            "type": "string",
            "enum": [
              "lead",
              "member"
            ],
            "default": "member"
          }
        },
        "required": [
          "email",
          "teamId"
        ]
      },
      "NotificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "waiting",
              "sent_back",
              "closed"
            ],
            "description": "Why this notice was created."
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "nullable": true
          },
          "readAt": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "body",
          "createdAt"
        ]
      },
      "NotificationListDto": {
        "type": "object",
        "properties": {
          "unreadCount": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationDto"
            }
          }
        },
        "required": [
          "unreadCount",
          "items"
        ]
      },
      "PatchNotificationDto": {
        "type": "object",
        "properties": {
          "read": {
            "type": "boolean",
            "description": "Set true to mark the notice as read."
          }
        },
        "required": [
          "read"
        ]
      },
      "DashboardOldestJobDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "publicId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phaseName": {
            "type": "string"
          },
          "subTeamName": {
            "type": "string"
          },
          "daysWaiting": {
            "type": "number"
          }
        },
        "required": [
          "projectId",
          "publicId",
          "name",
          "phaseName",
          "subTeamName",
          "daysWaiting"
        ]
      },
      "DashboardWaitingItemDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "projectPublicId": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "phasePublicId": {
            "type": "string"
          },
          "phaseName": {
